# ---------------------------------------------------------------------------
# CinemaVerse - ortam degiskenleri
# Bu dosyayi `.env.local` olarak kopyalayin. `.env.local` Git'e eklenmez.
# ---------------------------------------------------------------------------

# Oturum imzalama anahtari (zorunlu). Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# SQLite veritabani dosyasi (varsayilan: ./data/cinemaverse.db)
# DATABASE_PATH=./data/cinemaverse.db

# Uygulamanin dis URL'i (varsayilan: http://localhost:3000)
# APP_URL=http://localhost:3000

# --- Film/dizi metadata saglayicilari --------------------------------------
# Varsayilan olarak anahtar gerektirmeyen kaynaklar kullanilir:
#   Filmler  -> Wikidata / Wikipedia
#   Diziler  -> TVmaze
# Asagidaki anahtarlar OPSIYONELDIR. Tanimlanirsa daha zengin veri (poster,
# Turkce baslik, oyuncu kadrosu) gelir.

# TMDB v3 Read Access Token (https://www.themoviedb.org/settings/api)
# Tanimlanirsa kaynak temelli inceleme arastirmasinda TMDB kullanici
# incelemeleri de toplanir (aksi halde yalnizca Wikipedia kullanilir).
# TMDB_READ_TOKEN=

# OMDb API anahtari (https://www.omdbapi.com/apikey.aspx, ucretsiz 1.000/gun)
# OMDB_API_KEY=

# TMDb API anahtari v3 (fragmanlar icin; themoviedb.org -> Ayarlar -> API)
# TMDB_API_KEY=

# --- Yapay zeka saglayicilari (opsiyonel) ----------------------------------
# AI_PROVIDER: gemini | openai-compatible | none  (varsayilan: none)
# Not: yerel Ollama destegi kaldirildi; uygulama artik Ollama kullanmaz.
AI_PROVIDER=none

# Google Gemini API (ucretsiz kota mevcuttur, kota degisebilir)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI uyumlu herhangi bir sunucu (LM Studio, vLLM, OpenRouter vb.)
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=local-model
